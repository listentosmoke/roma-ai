# Copy this file to `.env` (which is gitignored) and add your keys.
# Restart `npm run dev` after changing this file.
#
# SECURITY: none of these keys are VITE_-prefixed, so none are inlined into the
# browser bundle. The dev server (server/*.mjs, served by the Vite plugin) reads
# them and exposes only /api/* routes + short-lived Deepgram tokens to the client.

# ── Deepgram (speech-to-text + diarization) — SERVER-SIDE ONLY ─────────────────
# Get a free key at https://console.deepgram.com (includes free credit).
# The browser streams through a local proxy (/api/deepgram/stream) that adds the
# key server-side; the key itself never reaches the client bundle. (Legacy
# VITE_DEEPGRAM_API_KEY is still accepted by the server with a warning — rename
# it to drop the VITE_ prefix.)
DEEPGRAM_API_KEY=

# ── Groq (main agent + vision + proactive) — SERVER-SIDE ONLY ─────────────────
# Get a key at https://console.groq.com. Read by the dev server's /api routes
# (server/groqApi.js); client code never references it. Do NOT add a VITE_
# prefix — the test suite fails if client code can see it.
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-20b
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# OPPORTUNITY_MODEL=openai/gpt-oss-20b   (proactive evaluation; defaults to GROQ_MODEL)

# ── Text-to-speech (Selective Voice Delivery) — SERVER-SIDE ONLY ──────────────
# Defaults to Deepgram Aura on the DEEPGRAM_API_KEY above, so nothing extra is
# needed to hear Roma. (Groq's PlayAI TTS was decommissioned; TTS_PROVIDER=groq
# still works against any OpenAI-compatible /audio/speech route.)
# TTS_PROVIDER=deepgram
# TTS_API_KEY=          # defaults to DEEPGRAM_API_KEY (deepgram) / GROQ_API_KEY (groq)
# TTS_BASE_URL=https://api.deepgram.com/v1
# TTS_MODEL=aura-2-thalia-en
# TTS_VOICE=aura-2-thalia-en

# ── Server data API authentication ────────────────────────────────────────────
# Unset (default): development mode — a fixed deterministic principal, clearly
# NOT production authentication. AUTH_MODE=production fails CLOSED (401 on every
# data request) until a real token verifier is wired into server/auth.mjs.
# AUTH_MODE=development
# DEV_PRINCIPAL_USER_ID=dev_user
# DEV_PRINCIPAL_WORKSPACE_ID=dev_workspace

# ── Voice delivery tuning (optional; VITE_-safe, non-secret) ───────────────────
# VITE_SPEECH_GAP_MIN_MS=700     # min quiet gap before speak_when_convenient plays
# VITE_SPEECH_GAP_MAX_WAIT_MS=5000
# VITE_BARGE_IN_MIN_MS=200       # min genuine-speech duration to interrupt Roma

# Real voice identity (SERVER-SIDE ONLY). Never use a VITE_ prefix.
BIOMETRIC_ENCRYPTION_KEY=
BIOMETRIC_ENCRYPTION_KEY_VERSION=1

# ── Background engineering worker (SERVER-SIDE ONLY; see AGENT-ENV.md) ────────
# Which engine runs background tasks. `mock` (the default) is deterministic and
# spawns nothing; `qwen` runs the real locally installed Qwen Code CLI.
# A test run always forces `mock` regardless of what is set here.
# AGENT_WORKER=mock
#
# The worker's OWN provider credential. It runs with a private QWEN_HOME and
# therefore cannot borrow your personal ~/.qwen login — without this key every
# task fails, which is deliberate: the worker's identity is deployment
# configuration, rotatable in one place, and can never quietly bill your
# personal account. Use a restricted/scoped key.
# AGENT_WORKER_API_KEY=
# AGENT_WORKER_API_BASE=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# AGENT_WORKER_MODEL=qwen3-coder-plus
#
# Optional: where to find the CLI, if it is not in the standard install path.
# Must be a JS entry point or a real executable — a .cmd/.bat shim is refused
# because launching one would require a shell.
# AGENT_WORKER_CMD=
# VOICE_IDENTITY_MODEL=Xenova/wavlm-base-plus-sv
# VOICE_IDENTITY_MODEL_REVISION=e61029603001bd11295c36d878698708bf59190f
# VOICE_IDENTITY_DTYPE=q8
# VOICE_IDENTITY_DEVICE=cpu
