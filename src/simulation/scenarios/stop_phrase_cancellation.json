{
  "scenarioId": "stop_phrase_cancellation",
  "version": 1,
  "family": "room",
  "description": "A deterministic stop phrase spoken through the virtual microphone cancels Roma's real playback without an LLM round-trip.",
  "environment": { "roomProfile": "close_speaker", "visualTier": "deterministic_geometric" },
  "people": [
    { "simulationId": "sim_orion", "voice": "aura:aura-2-orion-en", "position": { "x": 0, "y": 0, "z": 0.5 } }
  ],
  "events": [
    { "action": "ui.click", "control": "start" },
    { "action": "person.speak", "person": "sim_orion", "text": "Roma, please tell me a short story about a lighthouse, in about four sentences.", "addressedToRoma": true },
    { "action": "person.interrupt", "person": "sim_orion", "text": "Stop.", "afterPlaybackMs": 500 },
    { "action": "wait_for", "condition": "roma.playback_stopped", "timeoutMs": 20000 },
    { "action": "assert", "condition": "roma.no_console_errors" }
  ]
}
